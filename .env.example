DATABASE_URL=file:./data/Citizavrexo.db
RECOVERY_CODE_PEPPER=replace-with-at-least-32-random-characters

# Resend transactional email. Keep the API key server-only.
RESEND_API_KEY=
EMAIL_FROM=CITIZAVREXO <no-reply@citizavrexo.com>
APP_URL=https://citizavrexo.com

# Persistent profile images and official Customer Service channels.
PROFILE_IMAGE_DIR=./data/profile-images
CUSTOMER_SERVICE_EMAIL=
CUSTOMER_SERVICE_WHATSAPP_URL=https://wa.me/447392968025
CUSTOMER_SERVICE_LINE_URL=https://line.me/ti/p/RDf5RXaT2G

# Optional encrypted off-site backups. The worker stays disabled unless every secret is configured.
BACKUP_ENCRYPTION_KEY=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=citizavrexo
BACKUP_RETENTION_DAYS=35
BACKUP_SCHEDULE_HOURS=24
BACKUP_STATE_FILE=./data/backups/offsite-success.json

# Server-only Open Exchange Rates integration. Cross-currency transfers fail closed unless configured.
EXCHANGE_RATE_PROVIDER=open_exchange_rates
OPEN_EXCHANGE_RATES_APP_ID=
EXCHANGE_RATE_TIMEOUT_MS=8000
EXCHANGE_RATE_MAX_AGE_SECONDS=21600

# Supply these only while running db:bootstrap-admin, then remove them.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
